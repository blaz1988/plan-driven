#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the spec suite across Ruby and Rails versions.
#
#   bin/matrix              # every combination this machine can run
#   bin/matrix 3.3.3        # only that Ruby
#
# Rubies come from rbenv (RBENV_VERSION), Rails versions from gemfiles/.
require "English"

COMBINATIONS = {
  "3.1.2" => %w[7.0 7.1 7.2],
  "3.2.6" => %w[7.0 7.1 7.2 8.0 8.1],
  "3.3.3" => %w[7.0 7.1 7.2 8.0 8.1],
  "3.4.1" => %w[7.2 8.0 8.1]
}.freeze

ROOT = File.expand_path("..", __dir__)
wanted = ARGV.empty? ? COMBINATIONS.keys : ARGV

results = []

COMBINATIONS.each do |ruby, rails_versions|
  next unless wanted.include?(ruby)

  rails_versions.each do |rails|
    gemfile = "gemfiles/rails_#{rails}.gemfile"
    env = { "RBENV_VERSION" => ruby, "BUNDLE_GEMFILE" => File.join(ROOT, gemfile) }
    label = "ruby #{ruby} / rails #{rails}"

    print "#{label.ljust(26)} installing... "
    unless system(env, "bundle", "install", "--quiet", chdir: ROOT)
      puts "BUNDLE FAILED"
      results << [label, "bundle failed"]
      next
    end

    print "running... "
    command = ["bundle", "exec", "rspec", "--format", "progress"]
    output = IO.popen(env, command, chdir: ROOT, err: %i[child out], &:read)
    summary = output[/^\d+ examples?, .*$/] || output.lines.last.to_s.strip
    ok = $CHILD_STATUS.success?

    puts ok ? "OK   #{summary}" : "FAILED"
    puts output unless ok
    results << [label, ok ? summary : "FAILED"]
  end
end

puts
puts "Summary"
puts "-" * 60
results.each { |label, summary| puts "  #{label.ljust(26)} #{summary}" }

exit results.all? { |_, summary| summary.include?("0 failures") } ? 0 : 1
